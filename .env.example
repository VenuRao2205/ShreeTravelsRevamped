# Site
NEXT_PUBLIC_SITE_URL=https://www.shreetravelsnagpur.com

# MongoDB Atlas (reuse existing cluster)
MONGODB_URI=

# PhonePe v2 (production) - Client ID / Secret from PhonePe Business dashboard
PHONEPE_ENV=production            # production | sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# --- OR, if your dashboard only shows API Keys (Merchant ID + salt key + key index): ---
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# Email (SMTP). Yahoo requires an "app password", not the account password.
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_USER=shreetravelsngp@yahoo.com
SMTP_PASS=
MAIL_TO=shreetravelsngp@yahoo.com

# Admin panel
ADMIN_PASSWORD=

# WhatsApp Business Cloud API (optional). Leave empty to keep WhatsApp alerts off.
# Permanent token from a Meta system user, the Phone number ID, and your own WhatsApp number to receive alerts.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OWNER_NUMBER=
# Optional: WHATSAPP_API_VERSION=v23.0  WHATSAPP_TEMPLATE_LANG=en

# Google reviews links (optional). Review link: Google Business Profile > "Ask for reviews". Maps link: your listing's Share link.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_GOOGLE_MAPS_URL=
